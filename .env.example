# M Post Office production environment
COMPOSE_PROJECT_NAME=m-post-office
M_POST_OFFICE_IMAGE=m-post-office:local

# Public URL. Use a real DNS name for automatic HTTPS. For local HTTP testing,
# set SITE_ADDRESS=:80, APP_DOMAIN=localhost and COOKIE_SECURE=false.
SITE_ADDRESS=mail.example.com
APP_DOMAIN=mail.example.com
PUBLIC_URL=https://mail.example.com
APP_NAME="M Post Office"
ACME_EMAIL=postmaster@example.com
HTTP_PORT=80
HTTPS_PORT=443

# scripts/deploy.sh init replaces the CHANGE_ME values with random strings.
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET
DJANGO_ALLOWED_HOSTS=mail.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mail.example.com
COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

POSTGRES_DB=m_post_office
POSTGRES_USER=m_post_office
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_HOST=redis
REDIS_PORT=6379
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Connect these values to an existing Postfix/Dovecot or managed mail service.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SOCKET_TYPE=SSL
DOVECOT_OPERATION_MODE=rest
DOVEADM_API_URL=https://imap.example.com:8080/doveadm/v1
DOVEADM_API_KEY=CHANGE_ME_DOVEADM_API_KEY
DOVEADM_API_TIMEOUT=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SOCKET_TYPE=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL="M Post Office <postmaster@example.com>"
